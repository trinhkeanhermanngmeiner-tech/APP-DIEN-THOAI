<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:paddingStart="8dp" android:paddingEnd="8dp" android:paddingTop="3dp" android:paddingBottom="3dp">
    <LinearLayout android:id="@+id/gi_root" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/note_w" android:orientation="vertical" android:paddingStart="10dp" android:paddingTop="4dp" android:paddingBottom="8dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
            <TextView android:id="@+id/gi_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:ellipsize="end" android:maxLines="1" android:paddingTop="4dp" android:textColor="@color/widget_ink" android:textSize="14sp" android:textStyle="bold" />
            <ImageView android:id="@+id/gi_pin" android:layout_width="36dp" android:layout_height="34dp" android:padding="8dp"
                android:src="@drawable/ic_pin_off" android:contentDescription="Ghim ghi chú" />
            <ImageView android:id="@+id/gi_toggle" android:layout_width="36dp" android:layout_height="34dp" android:padding="7dp"
                android:src="@drawable/ic_expand" android:contentDescription="Mở rộng ghi chú" />
        </LinearLayout>
        <TextView android:id="@+id/gi_body" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:ellipsize="end" android:maxLines="6" android:paddingEnd="10dp" android:textColor="@color/widget_ink" android:alpha="0.85" android:textSize="12sp" />
        <TextView android:id="@+id/gi_full" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingEnd="10dp" android:textColor="@color/widget_ink" android:alpha="0.9" android:textSize="12.5sp" android:visibility="gone" />
        <TextView android:id="@+id/gi_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:paddingTop="4dp" android:paddingEnd="10dp" android:textColor="@color/widget_muted" android:textSize="10sp" />
    </LinearLayout>
</FrameLayout>
